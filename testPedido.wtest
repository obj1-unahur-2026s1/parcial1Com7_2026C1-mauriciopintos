import pedido.Pedido
import productos.Producto
import porciones.*

describe "Tests minimos para validar un pedido" {

    /*
    Configuración necesaria para mantener consistencia
    con los tests originales
    */

    var pedido
    var hamburguesa
    var ensalada
    var papasFritas
    var gaseosa
    var agua

    method initialize() {
        pedido = new Pedido()

        // Instanciación usando el constructor primitivo
        hamburguesa = new Producto(
            precioBase = 5000, 
            calorias = 500,
            esVegano =false
            )

        ensalada = new Producto(
            precioBase = 7000,
            calorias = 280,
            esVegano = true
            )

        papasFritas = new Producto(
            precioBase = 3000,
            calorias = 320,
            esVegano = false)
            
        gaseosa = new Producto(
            precioBase = 2000,
            calorias = 180,
            esVegano = false
            )

        agua = new Producto(
            precioBase = 1500,
            calorias = 5,
            esVegano = true)
    }

    /*
    Solamente cambiamos la inicialización de los tests, manteniendo los nombres
    de los objetos originales como variables y siguen funcionando correctamente
    "nada se pierde, todo se transforma"
    */
    test "agregar productos a un pedido" {
        pedido.agregarProducto(hamburguesa)
        pedido.agregarProducto(gaseosa)

        assert.equals(2, pedido.productos().size())
    }

    test "calcula correctamente el precio total" {
        pedido.agregarProducto(hamburguesa)
        pedido.agregarProducto(papasFritas)
        pedido.agregarProducto(gaseosa)

        assert.equals(10000, pedido.precioDelPedido())
    }

    test "calcula correctamente las calorias totales" {
        pedido.agregarProducto(hamburguesa)
        pedido.agregarProducto(papasFritas)
        pedido.agregarProducto(gaseosa)

        assert.equals(1000, pedido.caloriasTotales())
    }

    test "obtiene los productos veganos" {
        pedido.agregarProducto(hamburguesa)
        pedido.agregarProducto(ensalada)
        pedido.agregarProducto(agua)

        assert.equals(
            [ensalada, agua],
            pedido.productosVeganos()
        )
    }

    test "detecta productos con mas de 400 calorias" {
        pedido.agregarProducto(agua)
        pedido.agregarProducto(hamburguesa)

        assert.that(pedido.tieneProductosConMasDe400Calorias())
    }

    test "no detecta productos con mas de 400 calorias cuando no existen" {
        pedido.agregarProducto(agua)
        pedido.agregarProducto(gaseosa)

        assert.notThat(
            pedido.tieneProductosConMasDe400Calorias()
        )
    }

    test "modificar la porcion modifica el precio del producto" {
        hamburguesa.porcion(grande)

        assert.equals(10000, hamburguesa.precio())
    }

    test "el pedido refleja correctamente cambios de estado en un producto" {
        pedido.agregarProducto(hamburguesa)

        assert.equals(5000, pedido.precioDelPedido())

        hamburguesa.porcion(grande)

        assert.equals(10000, pedido.precioDelPedido())
    }

    test "agrandar combo cambia todas las porciones a grande" {
        pedido.agregarProducto(hamburguesa)
        pedido.agregarProducto(gaseosa)

        pedido.agrandarCombo()

        assert.equals(14000, pedido.precioDelPedido())
    }
}
